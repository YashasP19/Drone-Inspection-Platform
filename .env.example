# ========================================================
# Drone Infrastructure Inspector - Environment Variables
# ========================================================

# Host port mapping (default is 80 for production HTTP)
HOST_PORT=80

# Groq API Key (Required for multi-agent LangGraph pipeline & vision model)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (Used by legacy orchestrator)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Drive API Key (Optional: for fetching images from public Drive links)
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here
